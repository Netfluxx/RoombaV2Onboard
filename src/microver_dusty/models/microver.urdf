<robot name="microver">
  <!-- speeds are in m/2 or rad/s, dimensions in m, weights in kg -->
  <!-- ALL CREDITS GO TO JOSH NEWANS OF ARTICULATED ROBOTICS FOR> ANYTHING GAZEBO RELATED-->
  <!-- Specify some standard inertial calculations https://en.wikipedia.org/wiki/List_of_moments_of_inertia -->
  <!-- These make use of xacro's mathematical functionality -->
  <!-- Controller for the 4 wheeled differential drive microver inchallah-->
  <gazebo>
    <plugin filename="libgazebo_ros_diff_drive.so" name="skid_steer_drive">
      <num_wheel_pairs>2</num_wheel_pairs>
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <left_joint>back_left_wheel_joint</left_joint>
      <right_joint>back_right_wheel_joint</right_joint>
      <wheel_separation>0.26</wheel_separation>
      <!-- <wheel_separation>${WIDTH + (2*LEG_WIDTH) + WHEEL_WIDTH}</wheel_separation> -->
      <wheel_diameter>0.08</wheel_diameter>
      <!-- <wheel_diameter>${2*WHEEL_RADIUS}</wheel_diameter> -->
      <max_wheel_torque>5</max_wheel_torque>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>
      <!-- output -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <odometry_topic>odom</odometry_topic>
      <robot_base_frame>base_link</robot_base_frame>
      <odometry_source>0</odometry_source>
      <!--0=Encoders,1=World, default =world-->
      <ros>
        <remapping>odom:=wheel/odometry</remapping>
      </ros>
    </plugin>
  </gazebo>
  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>
  <material name="blue">
    <color rgba="0.2 0.2 1 1"/>
  </material>
  <material name="purple">
    <color rgba="0.62 0.12 0.94 1"/>
  </material>
  <!-- the base link located in the middle of the line between the center of both back wheels -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="0.003" radius="0.003"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="white"/>
    </visual>
  </link>
  <!-- ####################### JOINTS ########################## -->
  <joint name="chassis_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="chassis"/>
  </joint>
  <!-- WHEEL JOINTS -->
  <joint name="front_left_wheel_joint" type="continuous">
    <origin rpy="-1.5707963267948966 0 0" xyz="0.25 0.13 0.04"/>
    <parent link="base_link"/>
    <child link="front_left_wheel_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="100"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>
  <joint name="front_right_wheel_joint" type="continuous">
    <origin rpy="1.5707963267948966 0 0" xyz="0.25 -0.13 0.04"/>
    <parent link="base_link"/>
    <child link="front_right_wheel_link"/>
    <axis xyz="0 0 -1"/>
    <limit effort="100" velocity="100"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>
  <joint name="back_left_wheel_joint" type="continuous">
    <origin rpy="-1.5707963267948966 0 0" xyz="0 0.13 0.04"/>
    <parent link="base_link"/>
    <child link="back_left_wheel_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="100"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>
  <joint name="back_right_wheel_joint" type="continuous">
    <origin rpy="1.5707963267948966 0 0" xyz="0 -0.13 0.04"/>
    <parent link="base_link"/>
    <child link="back_right_wheel_link"/>
    <axis xyz="0 0 -1"/>
    <limit effort="100" velocity="100"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>
  <!-- LEG JOINTS = FIXED -->
  <joint name="back_left_leg_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.09 0.09"/>
    <parent link="base_link"/>
    <child link="back_left_leg_link"/>
  </joint>
  <joint name="back_right_leg_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.09 0.09"/>
